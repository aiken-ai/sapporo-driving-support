{
  "version": 1,
  "include": ["/*"],
  "exclude": [
    "/js/*",
    "/css/*",
    "/images/*",
    "/assets/*",
    "/*.{ico,svg,png,jpg,jpeg,gif,webp,ttf,woff,woff2,json,xml,txt,pdf}",
    "/.well-known/*"
  ],
  "rules": [
    {
      "include": ["/*"],
      "exclude": [
        "/js/*",
        "/css/*",
        "/images/*",
        "/assets/*",
        "/*.{ico,svg,png,jpg,jpeg,gif,webp,ttf,woff,woff2,json,xml,txt,pdf}",
        "/.well-known/*"
      ],
      "middleware": "./index.html"
    }
  ]
}
